# Forest Guardian backend — sample environment
# Copy to .env and adjust.

# Server
PORT=3000
NODE_ENV=development
PUBLIC_URL=http://localhost:3000

# Database (SQLite file path, relative to project root)
DB_PATH=./data/forest-guardian.db

# Uploads
UPLOAD_DIR=./server/uploads
MAX_UPLOAD_MB=8

# CORS (comma-separated origins, or * for any)
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Weather provider (optional — if missing, mock data is returned)
# Open-Meteo is free/keyless; leave blank to use mock.
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=
